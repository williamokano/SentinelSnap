{
  "title": "SentinelSnap",
  "uid": "sentinelsnap",
  "description": "Runtime, HTTP, database, and application metrics for SentinelSnap",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "tags": ["sentinelsnap"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP — Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"sentinelsnap\"}[2m])) by (http_route, http_request_method)",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP — Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"sentinelsnap\",http_response_status_code=~\"5..\"}[2m])) / sum(rate(http_server_request_duration_seconds_count{job=\"sentinelsnap\"}[2m]))",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP — p99 / p95 / p50 Latency",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{job=\"sentinelsnap\"}[2m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=\"sentinelsnap\"}[2m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket{job=\"sentinelsnap\"}[2m])) by (le))",
          "legendFormat": "p50",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active HTTP Requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "expr": "sum(http_server_active_requests{job=\"sentinelsnap\"})",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Snaps Created (rate)",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 8, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(sentinelsnap_snaps_created_total{job=\"sentinelsnap\"}[5m])",
          "legendFormat": "snaps/s",
          "refId": "A"
        },
        {
          "expr": "rate(sentinelsnap_photos_stored_total{job=\"sentinelsnap\"}[5m])",
          "legendFormat": "photos/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Photo Upload Bytes (rate)",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 8, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(sentinelsnap_photos_bytes_stored_bytes_total{job=\"sentinelsnap\"}[5m])",
          "legendFormat": "bytes/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Photo Size Distribution (p99 / p95 / p50)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(sentinelsnap_photo_size_bytes_bucket{job=\"sentinelsnap\"}[10m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sentinelsnap_photo_size_bytes_bucket{job=\"sentinelsnap\"}[10m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(sentinelsnap_photo_size_bytes_bucket{job=\"sentinelsnap\"}[10m])) by (le))",
          "legendFormat": "p50",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "title": "SSE — Connected Clients",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sentinelsnap_sse_clients{job=\"sentinelsnap\"}",
          "legendFormat": "clients",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "SSE — Broadcasts by Event Type",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(sentinelsnap_sse_broadcasts_total{job=\"sentinelsnap\"}[2m])",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Go — Goroutines",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "process_runtime_go_goroutines{job=\"sentinelsnap\"}",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Go — Heap Memory",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "process_runtime_go_mem_heap_alloc_bytes{job=\"sentinelsnap\"}",
          "legendFormat": "heap alloc",
          "refId": "A"
        },
        {
          "expr": "process_runtime_go_mem_heap_inuse_bytes{job=\"sentinelsnap\"}",
          "legendFormat": "heap in-use",
          "refId": "B"
        },
        {
          "expr": "process_runtime_go_mem_heap_sys_bytes{job=\"sentinelsnap\"}",
          "legendFormat": "heap sys",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "title": "Go — GC Pause (p99)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(process_runtime_go_gc_pause_ns_bucket{job=\"sentinelsnap\"}[5m])) by (le))",
          "legendFormat": "GC pause p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "DB Pool — Open Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "db_client_connections_max{job=\"sentinelsnap\"}",
          "legendFormat": "max",
          "refId": "A"
        },
        {
          "expr": "db_client_connections_idle{job=\"sentinelsnap\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "db_client_connections_pending_requests{job=\"sentinelsnap\"}",
          "legendFormat": "pending",
          "refId": "C"
        }
      ]
    },
    {
      "id": 14,
      "title": "DB Pool — Connection Timeouts",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(db_client_connections_timeouts_total{job=\"sentinelsnap\"}[5m])",
          "legendFormat": "timeouts/s",
          "refId": "A"
        },
        {
          "expr": "rate(db_client_connections_idle_closed_total{job=\"sentinelsnap\"}[5m])",
          "legendFormat": "idle-closed/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 15,
      "title": "DB Pool — Acquisition Wait Time (p99)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(db_client_connections_wait_time_seconds_bucket{job=\"sentinelsnap\"}[5m])) by (le))",
          "legendFormat": "wait p99",
          "refId": "A"
        }
      ]
    }
  ]
}
