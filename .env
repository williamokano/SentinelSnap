# Application
HTTP_PORT=8080

# Database
POSTGRES_DB=sentinelsnap
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
DB_DRIVER=postgres
DB_DSN=postgres://sentinel:sentinel@localhost:5432/sentinelsnap?sslmode=disable

# Storage
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_BASE_URL=http://localhost:8080/uploads

# S3 (required only when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
