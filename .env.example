# Application
HTTP_PORT=8080
# Static API token required on /snaps and /events (Authorization: Bearer <token>,
# or ?token=<token> for SSE). Leave empty to disable authentication entirely.
# Generate with e.g.: openssl rand -hex 32
API_TOKEN=

# Database
POSTGRES_DB=sentinelsnap
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
DB_DRIVER=postgres
DB_DSN=postgres://sentinel:sentinel@localhost:5432/sentinelsnap?sslmode=disable

# Storage
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# S3 (required only when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Logging (always active; no dependencies required)
LOG_LEVEL=info     # debug | info | warn | error
LOG_FORMAT=json    # json | text

# OpenTelemetry — set OTEL_ENABLED=true to activate metrics/traces/log-push
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sentinelsnap
# Shared OTLP collector endpoint (used when MetricsMode=push or TracesMode=push or LogsMode=push)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc    # grpc | http/protobuf
# Signal modes
OTEL_METRICS_MODE=pull    # pull (expose /metrics) | push (OTLP) | off
OTEL_TRACES_MODE=push     # push (OTLP) | off
OTEL_LOGS_MODE=stdout     # stdout (JSON to stdout, scraped by Promtail/Alloy) | push (OTLP)
OTEL_TRACES_SAMPLER_ARG=1.0   # trace sample ratio [0.0–1.0]
